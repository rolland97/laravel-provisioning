includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # ⚠️ AGENTS.md R-024: this level MUST NOT be lowered, and new code MUST NOT be
    # added to a baseline to silence an error. Static analysis is load-bearing here.
    level: 8

    paths:
        - src
        - config

    # The bridge is analysed with Filament installed (it is a require-dev package),
    # but it must never be *required*. AGENTS.md R-001.
    treatPhpDocTypesAsCertain: false
