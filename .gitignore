**/.DS_Store
.idea
.phpunit.result.cache
.phpunit.cache
.vscode
build
coverage
node_modules
phpunit.xml
phpstan.neon
testbench.yaml
vendor
*.log
.env
.env.*

# ⚠️ A library, not an application: the CI matrix runs both `prefer-lowest` and
# `prefer-stable`, which a committed lock file would defeat.
composer.lock

# Playwright MCP scratch output (browser verification runs)
.playwright-mcp

# Browser-test artefacts written by pest-plugin-browser on failure.
tests/Browser/Screenshots
package-lock.json

# ⚠️ resources/dist/ is deliberately NOT ignored (constitution VI: compiled assets ship committed).

# Installed agent tooling — the same category as vendor/ and node_modules/ above:
# generated by an installer, not hand-written, and reinstallable from
# .specify/init-options.json.
#
# ⚠️ `.specify/*`, NOT `.specify` — git cannot re-include a file whose parent
# DIRECTORY is excluded, so the carve-outs below would be silently dead.
.claude/
.specify/*
!.specify/memory/
!.specify/extensions.yml
# ⚠️ Kept, unlike filament-tours, which ignores it. This file is a hand-written
# TRUST decision (which extension catalog may install), not installer output —
# without it a fresh clone cannot reinstall superb/memorylint, which is part of
# why that repo's reinstall path is recorded as untested.
!.specify/extension-catalogs.yml
